# OAuth 2.0 Configuration for Subly Extension
# Copy this file to .env.local and fill in your actual Client IDs

# Development Client ID (for local testing with `npm run build:ext:dev`)
# Create this in Google Cloud Console with your local Extension ID from chrome://extensions
VITE_OAUTH_CLIENT_ID_DEV=YOUR_DEV_CLIENT_ID_HERE

# Production Client ID (for Chrome Web Store with `npm run build:ext:prod`)
# Create this in Google Cloud Console with your permanent Extension ID from CWS
VITE_OAUTH_CLIENT_ID_PROD=YOUR_PROD_CLIENT_ID_HERE

# Tip: copy this file to `.env.local` and fill both values. You can also run
# `npm run configure-oauth` to interactively set them.

# Optional: Exchange rate API key (if using custom exchange rate provider)
# VITE_EXCHANGE_API_KEY=your_api_key_here
# VITE_EXCHANGE_API_URL=https://your-api.com/v1/rates
